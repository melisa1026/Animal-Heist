#version 140

in highp vec4 position;
in mediump vec3 normal;
in mediump vec2 texcoord0;

out highp vec4 var_position;
out mediump vec3 var_normal;
out mediump vec2 var_texcoord0;
out mediump vec4 var_light;

uniform vx_uniforms
{
	highp mat4 mtx_world;
	highp mat4 mtx_view;
	highp mat4 mtx_proj;
	highp mat4 mtx_normal;
	mediump vec4 light;
};

void main()
{
	highp vec4 world_pos = mtx_world * vec4(position.xyz, 1.0);

	gl_Position = mtx_proj * mtx_view * world_pos;

	var_position = world_pos;
	var_normal = normalize((mtx_normal * vec4(normal, 0.0)).xyz);
	var_texcoord0 = texcoord0;

	// Pass light straight through as a direction, not a position
	var_light = vec4(normalize(light.xyz), 0.0);
}